# Copy to backend/.env for local development. On Railway, set these as service variables.
# Never commit real keys.

DATABASE_URL=postgresql://app:app@localhost:5432/cryptosig
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional. Pro plan detection, credit pacing and candle cross-checks; keyless API otherwise.
CMC_API_KEY=
# Used from Phase 7 (AI reasoning layer).
OPENAI_API_KEY=

# Phase 2 signal and risk settings (defaults shown; remove a line to keep the default).
SIGNAL_MIN_SCORE_STRONG_BUY=80
SIGNAL_MIN_SCORE_BUY=65
SIGNAL_MIN_SCORE_WATCH=50
RISK_MAX_PER_SIGNAL_PCT=1.0
RISK_MAX_ALLOCATION_PCT=10.0
RISK_FEE_PCT=0.1
RISK_SLIPPAGE_PCT=0.05
RISK_MIN_REWARD_RISK=1.5
RISK_STRONG_MIN_REWARD_RISK=2.0
SIGNAL_SCAN_CACHE_SECONDS=120
