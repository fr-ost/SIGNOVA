# Copy to backend/.env for local development. On Railway, set these as service variables.
# Never commit real keys.

DATABASE_URL=postgresql://app:app@localhost:5432/cryptosig
ENVIRONMENT=development
LOG_LEVEL=INFO

# Optional. Pro plan detection, credit pacing and candle cross-checks; keyless API otherwise.
CMC_API_KEY=
# Optional. CoinGecko Demo (free) key; set COINGECKO_PLAN=pro for a paid key.
COINGECKO_API_KEY=
COINGECKO_PLAN=demo
# AI chat assistant.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
# GPT-5 / o-series: reasoning effort (minimal, low, medium, high) and extra token room for reasoning.
CHAT_REASONING_EFFORT=low
CHAT_REASONING_BUDGET_TOKENS=6000
# Protects Analyze now/Stop, watchlist edits, chat and portfolio. Set a long random value.
ADMIN_TOKEN=
# 0 = analysis only when you press Analyze now.
AUTO_ANALYZE_MINUTES=0

# Phase 2 signal and risk settings (defaults shown; remove a line to keep the default).
SIGNAL_MIN_SCORE_STRONG_BUY=80
SIGNAL_MIN_SCORE_BUY=65
SIGNAL_MIN_SCORE_WATCH=50
RISK_MAX_PER_SIGNAL_PCT=1.0
RISK_MAX_ALLOCATION_PCT=10.0
RISK_FEE_PCT=0.1
RISK_SLIPPAGE_PCT=0.05
RISK_MIN_REWARD_RISK=1.5
RISK_STRONG_MIN_REWARD_RISK=2.0

# Phase 5 sentiment and on-chain (free keyless sources; defaults shown).
SENTIMENT_CACHE_SECONDS=600
ONCHAIN_CACHE_SECONDS=600
WHALE_MIN_BTC=100
WHALE_MIN_ETH=1000
# Optional: Whale Alert key for labelled transfers on every major chain.
WHALE_ALERT_API_KEY=

# Optional. Token unlocks (Mobula, free key) and airdrops (AlphaDrops Developer API).
MOBULA_API_KEY=
ALPHADROPS_API_KEY=
